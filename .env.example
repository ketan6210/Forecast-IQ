# SQLite is a local development fallback. Compose uses PostgreSQL.
DATABASE_URL=sqlite:///./storage/forecastiq.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25
MAX_DATASET_ROWS=1000000
MAX_TRAINING_PERIODS=5000
# Optional CPU PyTorch runtime. Short histories use the other model families.
INSTALL_NEURAL=false
# Change these if another local application already uses the default ports.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Compose development database credentials (replace before sharing a deployment).
POSTGRES_USER=forecastiq
POSTGRES_PASSWORD=forecastiq_dev
POSTGRES_DB=forecastiq
